# Database
DB_PASSWORD=replace-with-a-strong-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Google Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: sign up first, set the email here, restart once, then remove it.
ADMIN_BOOTSTRAP_EMAIL=

# Email verification
# Local development can use `log`; the verification code is returned only by
# the local API response. Production must use `smtp`.
MAIL_DELIVERY_MODE=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Set true after HTTPS is enabled in production.
SESSION_COOKIE_SECURE=false
